{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/context_session_hook.py\"",
            "timeout": 3,
            "statusMessage": "Preparing project intake",
            "additionalContextLimit": 2000
          }
        ]
      }
    ]
  }
}
